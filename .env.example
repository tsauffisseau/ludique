# Copy to .env (never commit .env).

# --- BoardGameGeek XML API2 -------------------------------------------------------------
# Register an application at https://boardgamegeek.com/applications to get a token.
# Only needed for live data (`--source api`, `refresh`); the offline sample works without it.
BGG_API_TOKEN=
# BGG_MIN_INTERVAL_S=2.0          # politeness delay between API calls (seconds)

# --- PostgreSQL (docker compose) -------------------------------------------------------
POSTGRES_USER=bgg
POSTGRES_PASSWORD=bgg
POSTGRES_DB=bgg
BGG_PG_HOST_PORT=55432            # host port; 5432 is often taken by a local PostgreSQL
# Used by local (non-Docker) runs and the test suite:
BGG_PG_DSN=postgresql://bgg:bgg@localhost:55432/bgg
BGG_TEST_PG_DSN=postgresql://bgg:bgg@localhost:55432/bgg_test

# --- Optional: S3 export for Athena ----------------------------------------------------
# BGG_S3_BUCKET=my-bucket
# BGG_S3_PREFIX=bgg
# AWS credentials: standard AWS env vars or ~/.aws (never put them in this repo)
